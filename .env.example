# ============================================================================
# Brixel FactoryOS - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# Then run: docker compose up -d
# ============================================================================

APP_NAME="Brixel FactoryOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8087

APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ============================================================================
# Database (PostgreSQL 18)
# ============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=factory
DB_USERNAME=factory
DB_PASSWORD=factory_secret

# ============================================================================
# Cache & Queue (Redis 8)
# ============================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# ============================================================================
# Mail
# ============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@factoryos.example"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# AWS S3 (Optional - for file storage)
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# Sanctum (SPA Authentication)
# ============================================================================
SANACTUM_STATEFUL_DOMAINS=localhost:8000
SESSION_DOMAIN=localhost

# ============================================================================
# Vite (Frontend Dev Server)
# ============================================================================
VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# Reverb (WebSockets for real-time notifications)
# ============================================================================
BROADCAST_DRIVER=reverb
REVERB_APP_KEY="factoryos-app-key"
REVERB_APP_SECRET="factoryos-app-secret"
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME="http"

# For frontend (Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================================================
# Licensing (On-premises support)
# ============================================================================
FACTORYOS_TENANT_MODEL=Tenancy\\Infrastructure\\Persistence\\Tenant
FACTORYOS_DEFAULT_CURRENCY=PKR
FACTORYOS_DEFAULT_TAX_JURISDICTION=PK
FACTORYOS_ACCOUNTING_ENGINE=double_entry
FACTORYOS_INVENTORY_LEDGER=immutable

LICENSE_MODE=local
LICENSE_FILE=storage/licence/licence.dat
LICENSE_VALIDATION_INTERVAL_HOURS=24