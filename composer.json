{
  "name": "brixel/factoryos",
  "type": "project",
  "license": "proprietary",
  "description": "Brixel FactoryOS \u2014 Configurable Manufacturing ERP Platform",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^11.0",
    "spatie/laravel-permission": "^6.0",
    "laravel/sanctum": "^4.0",
    "inertiajs/inertia-laravel": "^2.0",
    "tightenco/ziggy": "^2.0",
    "maatwebsite/excel": "^3.1",
    "barryvdh/laravel-dompdf": "^3.0",
    "predis/predis": "^2.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "ramsey/uuid": "^4.0",
    "brianium/paratest": "^6.0",
    "brick/math": "^0.10"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "laravel/telescope": "^5.0",
    "fakerphp/faker": "^1.23",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Tenancy\\": "src/Tenancy/",
      "Identity\\": "src/Identity/",
      "Organisation\\": "src/Organisation/",
      "Configuration\\": "src/Configuration/",
      "Products\\": "src/Products/",
      "Inventory\\": "src/Inventory/",
      "Purchasing\\": "src/Purchasing/",
      "Manufacturing\\": "src/Manufacturing/",
      "Production\\": "src/Production/",
      "Quality\\": "src/Quality/",
      "Costing\\": "src/Costing/",
      "Sales\\": "src/Sales/",
      "Dispatch\\": "src/Dispatch/",
      "Accounting\\": "src/Accounting/",
      "Maintenance\\": "src/Maintenance/",
      "HR\\": "src/HR/",
      "Reporting\\": "src/Reporting/",
      "Notifications\\": "src/Notifications/",
      "Integrations\\": "src/Integrations/",
      "Shared\\": "src/Shared/"
    }
  }
}
