{
  "name": "brixel/factoryos",
  "type": "project",
  "license": "proprietary",
  "description": "Brixel FactoryOS — Configurable Manufacturing ERP Platform",
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "inertiajs/inertia-laravel": "^2.0",
    "predis/predis": "^2.2",
    "league/flysystem-aws-s3-v3": "^3.0",
    "ramsey/uuid": "^4.7",
    "brianium/paratest": "^7.0",
    "brick/math": "^0.19"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "laravel/telescope": "^5.0",
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Tenancy\\": "src/Tenancy/",
      "Identity\\": "src/Identity/",
      "Organisation\\": "src/Organisation/",
      "Configuration\\": "src/Configuration/",
      "Products\\": "src/Products/",
      "Inventory\\": "src/Inventory/",
      "Purchasing\\": "src/Purchasing/",
      "Manufacturing\\": "src/Manufacturing/",
      "Production\\": "src/Production/",
      "Quality\\": "src/Quality/",
      "Costing\\": "src/Costing/",
      "Sales\\": "src/Sales/",
      "Dispatch\\": "src/Dispatch/",
      "Accounting\\": "src/Accounting/",
      "Maintenance\\": "src/Maintenance/",
      "HR\\": "src/HR/",
      "Reporting\\": "src/Reporting/",
      "Notifications\\": "src/Notifications/",
      "Integrations\\": "src/Integrations/",
      "Shared\\": "src/Shared/"
    }
  }
}
