# FactoryOS Testing Configuration

# Pest Configuration
php_version=8.3
phpunit_version=10.x

# Database Configuration for Testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Session Configuration
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Cache Configuration
CACHE_DRIVER=array

# Queue Configuration
QUEUE_CONNECTION=sync

# Mail Configuration
MAIL_MAILER=array

# Broadcast Driver
BROADCAST_DRIVER=log

# API Configuration
API_PREFIX=api/v2

# Application Configuration
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8000
