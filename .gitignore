# Zoventra FactoryOS — .gitignore

# Laravel
/vendor/
/node_modules/
/public/hot
/public/storage
/public/*.php
/resources/js/vendor
/storage/*.key
/bootstrap/cache/*.php
/.idea/
/.phpstorm.meta.php
.phpunit.result.cache
/ide-helper.php

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
/storage/logs/*.log

# Laravel runtime caches
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/

# Build artifacts
/dist/
/build/
/.next/
/.turbo/

# IDE
.vscode/
.idea/

# Environment / secrets
.env
.env.*.php
.env.local
.env.*.local
*.pem
*.key
*.crt

# IDE / temp
~*
*.tmp
*.bak

# Docker
.dockerignore